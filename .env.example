# Atlas environment variables. Copy to .env.local (never commit it).
# Server-only unless prefixed NEXT_PUBLIC_.

# Supabase (Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
# GitHub Actions use SUPABASE_URL (same value as NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_URL=https://xxxx.supabase.co

# Artificial Analysis free API key (/api/cron/aa)
AA_API_KEY=
# Hugging Face read-only token (GitHub Actions hf-sync)
HF_TOKEN=hf_xxx

# Ask AI (/api/ask-hardware): any OpenAI-compatible Chat Completions endpoint,
# or AI_PROVIDER=anthropic to use @anthropic-ai/sdk with the same three variables.
AI_PROVIDER=openai
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=
AI_MODEL=

# 32+ random characters; Vercel cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# /admin/match password (cookie after one prompt)
ADMIN_PASSWORD=
# 32+ random characters, salts probe fingerprints in /api/runs
RUNS_SALT=
# Public site URL (probe default endpoint, links). Defaults to http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev only: force the prototype sample data instead of Supabase
# ATLAS_SAMPLE=1
