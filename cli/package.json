{
  "name": "atlas-probe",
  "version": "1.0.0",
  "description": "Detect your AI hardware, benchmark it with your own llama.cpp, and print an Atlas profile.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "atlas-probe": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "llm",
    "llama.cpp",
    "benchmark",
    "gpu",
    "hardware"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.9.0"
  }
}
